# ============================================================
# Global Football Scout — environment configuration
# Copy to .env and fill in. Never commit .env.
# ============================================================

# --- Database (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=gfs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gfs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://gfs:change-me@localhost:5432/gfs

# --- Cache / queue ---
REDIS_URL=redis://localhost:6379/0

# --- Data provider API keys (leave blank to disable that provider) ---
# StatsBomb open data needs NO key (public GitHub repository, open licence with attribution).
FOOTBALL_DATA_ORG_API_KEY=
API_FOOTBALL_KEY=
SPORTMONKS_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- LLM (natural-language scouting + report narration only; never used for ranking) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Analytics defaults (user-adjustable in the UI) ---
MINIMUM_MINUTES=900
EXCLUDED_TOP_LEAGUES_COUNT=3
# Optional explicit override (comma-separated internal competition ids); blank = derive from league-strength model
EXCLUDED_COMPETITION_IDS=
SIMILARITY_RESULT_COUNT=10
PERCENTILE_MIN_POOL_SIZE=30

# --- App ---
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Public deployment (docker-compose.prod.yml) ---
# Domain whose DNS A record points at the server; Caddy gets the HTTPS certificate for it.
DOMAIN=
# Required for the admin identity-review queue and cache clearing; blank disables them.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
# Comma-separated browser origins allowed to call the API directly (prod sets https://$DOMAIN).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# LLM spend guards (natural-language search + report narratives). Requests over either
# limit get no LLM call; without Redis no LLM call is made at all.
LLM_HOURLY_LIMIT_PER_CLIENT=20
LLM_DAILY_LIMIT=500
# Nightly backups (scripts/deploy/backup.sh): bundles kept on the server, and an optional
# rsync target (e.g. a Hetzner Storage Box: u123456@u123456.your-storagebox.de:gfs-backups)
# that backups/ is mirrored to. Without it the backups share the server's disk.
BACKUP_KEEP=14
BACKUP_REMOTE=
