# ============================================================
# Global Football Scout — environment configuration
# Copy to .env and fill in. Never commit .env.
# ============================================================

# --- Database (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=gfs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gfs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://gfs:change-me@localhost:5432/gfs

# --- Cache / queue ---
REDIS_URL=redis://localhost:6379/0

# --- Data provider API keys (leave blank to disable that provider) ---
# StatsBomb open data needs NO key (public GitHub repository, open licence with attribution).
FOOTBALL_DATA_ORG_API_KEY=
API_FOOTBALL_KEY=
SPORTMONKS_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- LLM (natural-language scouting + report narration only; never used for ranking) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Analytics defaults (user-adjustable in the UI) ---
MINIMUM_MINUTES=900
PERCENTILE_MIN_POOL_SIZE=30

# --- App ---
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO
